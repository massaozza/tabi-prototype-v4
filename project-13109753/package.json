{
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@stripe/react-stripe-js": "4.0.2",
    "@supabase/supabase-js": "2.57.4",
    "@vercel/kv": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.4.15",
    "firebase": "12.0.0",
    "i18next": "25.4.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "0.539.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.6.0",
    "react-router-dom": "^7.6.3",
    "recharts": "3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vercel/node": "^5.10.2",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jiti": "^2.6.1",
    "postcss": "^8.5.6",
    "source-map": "^0.7.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "unplugin-auto-import": "^19.3.0",
    "vite": "^8.0.1"
  },
  "name": "react",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint src api --ext ts,tsx --report-unused-disable-directives",
    "preview": "vite preview",
    "type-check": "npm run type-check:app && npm run type-check:api",
    "i18n:extract": "node scripts/extract-ui-strings.mjs",
    "i18n:generate": "node scripts/generate-ui-translations.mjs",
    "type-check:app": "tsc --noEmit --project tsconfig.app.json",
    "type-check:api": "tsc --noEmit --project tsconfig.api.json",
    "snapshot:spots": "node scripts/generate-spot-snapshot.mjs",
    "osm:import": "esbuild scripts/osm-import.ts --bundle --platform=node --format=esm --target=node20 --outfile=.tmp/osm-import.mjs --log-level=warning && node .tmp/osm-import.mjs",
    "bulk-approve": "esbuild scripts/bulk-approve-content.ts --bundle --platform=node --format=esm --target=node20 --outfile=.tmp/bulk-approve-content.mjs --log-level=warning && node .tmp/bulk-approve-content.mjs",
    "repair-lost-drafts": "esbuild scripts/repair-lost-drafts.ts --bundle --platform=node --format=esm --target=node20 --outfile=.tmp/repair-lost-drafts.mjs --log-level=warning && node .tmp/repair-lost-drafts.mjs",
    "backfill-image-index": "esbuild scripts/backfill-image-index.ts --bundle --platform=node --format=esm --target=node20 --outfile=.tmp/backfill-image-index.mjs --log-level=warning && node .tmp/backfill-image-index.mjs",
    "bulk-publish": "esbuild scripts/bulk-publish.ts --bundle --platform=node --format=esm --target=node20 --outfile=.tmp/bulk-publish.mjs --log-level=warning && node .tmp/bulk-publish.mjs"
  },
  "type": "module",
  "version": "0.0.0"
}
